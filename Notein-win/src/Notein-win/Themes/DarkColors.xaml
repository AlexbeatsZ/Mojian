<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#181818</Color>
    <Color x:Key="TitleBarBackgroundColor">#1B1B1F</Color>
    <Color x:Key="RibbonBackgroundColor">#252528</Color>
    <Color x:Key="RibbonTabHoverColor">#333337</Color>
    <Color x:Key="RibbonTabSelectedColor">#2D2D30</Color>
    <Color x:Key="SectionPaneBackgroundColor">#1B1B1E</Color>
    <Color x:Key="PagePaneBackgroundColor">#252528</Color>
    <Color x:Key="RailBackgroundColor">#161618</Color>
    <Color x:Key="PaperBackgroundColor">#1B1B1B</Color>
    <Color x:Key="GridLineColor">#2D3238</Color>
    <Color x:Key="BorderHairlineColor">#38383C</Color>
    <Color x:Key="AccentPurpleColor">#773B94</Color>
    <Color x:Key="AccentBlueColor">#0078D4</Color>
    <Color x:Key="TagRedColor">#E83139</Color>
    <Color x:Key="TextPrimaryColor">#F1F1F1</Color>
    <Color x:Key="TextSecondaryColor">#A6A6A6</Color>
    <Color x:Key="TextMutedColor">#707070</Color>
    <Color x:Key="HoverOverlayColor">#1AFFFFFF</Color>
    <Color x:Key="SelectedOverlayColor">#30FFFFFF</Color>

    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarBackground" Color="{StaticResource TitleBarBackgroundColor}" />
    <SolidColorBrush x:Key="RibbonBackground" Color="{StaticResource RibbonBackgroundColor}" />
    <SolidColorBrush x:Key="RibbonTabHover" Color="{StaticResource RibbonTabHoverColor}" />
    <SolidColorBrush x:Key="RibbonTabSelected" Color="{StaticResource RibbonTabSelectedColor}" />
    <SolidColorBrush x:Key="SectionPaneBackground" Color="{StaticResource SectionPaneBackgroundColor}" />
    <SolidColorBrush x:Key="PagePaneBackground" Color="{StaticResource PagePaneBackgroundColor}" />
    <SolidColorBrush x:Key="RailBackground" Color="{StaticResource RailBackgroundColor}" />
    <SolidColorBrush x:Key="PaperBackground" Color="{StaticResource PaperBackgroundColor}" />
    <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}" />
    <SolidColorBrush x:Key="BorderHairline" Color="{StaticResource BorderHairlineColor}" />
    <SolidColorBrush x:Key="AccentPurple" Color="{StaticResource AccentPurpleColor}" />
    <SolidColorBrush x:Key="AccentBlue" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="TagRed" Color="{StaticResource TagRedColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="HoverOverlay" Color="{StaticResource HoverOverlayColor}" />
    <SolidColorBrush x:Key="SelectedOverlay" Color="{StaticResource SelectedOverlayColor}" />
    <SolidColorBrush x:Key="SelectionFill" Color="#280078D4" />
    <SolidColorBrush x:Key="SelectionStroke" Color="#0078D4" />

</ResourceDictionary>
