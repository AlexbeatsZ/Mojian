<UserControl x:Class="Notein_win.Controls.BackstageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:Notein_win.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource WindowBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Backstage Rail / Navigation -->
        <Border Grid.Column="0" Background="{StaticResource TitleBarBackground}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,16,0,16">
                <!-- Back button -->
                <Button DockPanel.Dock="Top"
                        Command="{Binding CloseBackstageCommand}"
                        Style="{StaticResource RibbonIconButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="16,0,0,24"
                        Width="38" Height="38">
                    <Path Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                          Fill="{StaticResource TextPrimary}"
                          Stretch="Uniform" Width="18" Height="18" />
                </Button>

                <!-- Navigation Tabs -->
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Content="信息" Tag="Info"
                                 IsChecked="{Binding BackstageTab, ConverterParameter=Info, Mode=OneWay}"
                                 Command="{Binding SelectBackstageTabCommand}" CommandParameter="Info"
                                 Style="{StaticResource RibbonTabButtonStyle}" HorizontalAlignment="Stretch" Margin="8,2" />
                    <RadioButton Content="新建笔记本" Tag="New"
                                 IsChecked="{Binding BackstageTab, ConverterParameter=New, Mode=OneWay}"
                                 Command="{Binding SelectBackstageTabCommand}" CommandParameter="New"
                                 Style="{StaticResource RibbonTabButtonStyle}" HorizontalAlignment="Stretch" Margin="8,2" />
                    <RadioButton Content="导出" Tag="Export"
                                 IsChecked="{Binding BackstageTab, ConverterParameter=Export, Mode=OneWay}"
                                 Command="{Binding SelectBackstageTabCommand}" CommandParameter="Export"
                                 Style="{StaticResource RibbonTabButtonStyle}" HorizontalAlignment="Stretch" Margin="8,2" />
                    <RadioButton Content="全屏快捷工具栏" Tag="ToolbarConfig"
                                 IsChecked="{Binding BackstageTab, ConverterParameter=ToolbarConfig, Mode=OneWay}"
                                 Command="{Binding SelectBackstageTabCommand}" CommandParameter="ToolbarConfig"
                                 Style="{StaticResource RibbonTabButtonStyle}" HorizontalAlignment="Stretch" Margin="8,2" />
                    <RadioButton Content="选项" Tag="Options"
                                 IsChecked="{Binding BackstageTab, ConverterParameter=Options, Mode=OneWay}"
                                 Command="{Binding SelectBackstageTabCommand}" CommandParameter="Options"
                                 Style="{StaticResource RibbonTabButtonStyle}" HorizontalAlignment="Stretch" Margin="8,2" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right Content Panels -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="36,24,36,24">
            <StackPanel>
                <!-- INFO PANEL -->
                <StackPanel Visibility="{Binding BackstageTab, Converter={x:Null}}">
                    <TextBlock Text="笔记本信息" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24" />
                    
                    <Border Background="{StaticResource RibbonBackground}" CornerRadius="6" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveNotebookTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
                            <TextBlock Text="当前活跃笔记本" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" />
                            
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="当前分区:" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding ActiveSectionTitle}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="当前页面:" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding ActivePageTitle}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="层级路径:" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding BreadcrumbText}" Foreground="{StaticResource TextSecondary}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Switch Notebook -->
                    <TextBlock Text="所有笔记本" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,16,0,12" />
                    <ItemsControl ItemsSource="{Binding Library.Notebooks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource RibbonBackground}" CornerRadius="4" Padding="14,10" Margin="0,4" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="打开"
                                                Command="{Binding DataContext.SelectNotebookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource RibbonIconButtonStyle}" Padding="12,4" />
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
