<Window x:Class="Notein_win.Controls.PageCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加页面" Width="520" Height="430" MinWidth="520" MinHeight="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#141414" Foreground="#F4F4F4"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F4F4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F4F4F4" />
            <Setter Property="BorderBrush" Value="#3D3D3D" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F4F4F4" />
            <Setter Property="BorderBrush" Value="#3D3D3D" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#333333" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid Margin="8,4,6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0" Stroke="#D6D6D6" StrokeThickness="1.2" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="340"
                                        Background="#242424" BorderBrush="#505050" BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F4F4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#374048" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#46515C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F4F4F4" />
            <Setter Property="BorderBrush" Value="#3D3D3D" />
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#B9B9B9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="18,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="添加页面" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="新建空白纸张，或把 PDF 分页导入为可批注页面" Foreground="#B9B9B9" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>

        <TabControl x:Name="ModeTabs" Grid.Row="1" Background="#111111" BorderBrush="#3D3D3D">
            <TabItem Header="页">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="页面标题" VerticalAlignment="Center" Foreground="#B9B9B9" />
                    <TextBox x:Name="TitleInput" Grid.Column="1" Text="无标题页" />
                    <TextBlock Grid.Row="1" Text="纸张" VerticalAlignment="Center" Foreground="#B9B9B9" Margin="0,14,0,0" />
                    <ComboBox x:Name="PaperPicker" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="0,12,0,0">
                        <ComboBoxItem Content="无界页面" Tag="Infinite" />
                        <ComboBoxItem Content="A4 页面" Tag="A4" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Text="基线" VerticalAlignment="Center" Foreground="#B9B9B9" Margin="0,14,0,0" />
                    <ComboBox x:Name="BackgroundPicker" Grid.Row="2" Grid.Column="1" SelectedIndex="5" Margin="0,12,0,0">
                        <ComboBoxItem Content="空白" Tag="Blank" />
                        <ComboBoxItem Content="窄横线" Tag="RuledNarrow" />
                        <ComboBoxItem Content="标准横线" Tag="RuledStandard" />
                        <ComboBoxItem Content="宽横线" Tag="RuledWide" />
                        <ComboBoxItem Content="密集网格" Tag="GridDense" />
                        <ComboBoxItem Content="标准网格" Tag="GridStandard" />
                        <ComboBoxItem Content="宽网格" Tag="GridWide" />
                        <ComboBoxItem Content="密集点阵" Tag="DotsDense" />
                        <ComboBoxItem Content="标准点阵" Tag="DotsStandard" />
                        <ComboBoxItem Content="宽点阵" Tag="DotsWide" />
                    </ComboBox>
                    <TextBlock Grid.Row="3" Text="页面颜色" VerticalAlignment="Center" Foreground="#B9B9B9" Margin="0,14,0,0" />
                    <ComboBox x:Name="ColorPicker" Grid.Row="3" Grid.Column="1" SelectedIndex="0" Margin="0,12,0,0">
                        <ComboBoxItem Content="深色 · 墨黑" Tag="Dark|#1B1B1B" />
                        <ComboBoxItem Content="深色 · 米色" Tag="Dark|#302A21" />
                        <ComboBoxItem Content="深色 · 蓝色" Tag="Dark|#1D2B38" />
                        <ComboBoxItem Content="深色 · 绿色" Tag="Dark|#1E3028" />
                        <ComboBoxItem Content="深色 · 粉色" Tag="Dark|#352329" />
                        <ComboBoxItem Content="浅色 · 白" Tag="Light|#FAFAFA" />
                        <ComboBoxItem Content="浅色 · 米色" Tag="Light|#F3E9D2" />
                        <ComboBoxItem Content="浅色 · 蓝色" Tag="Light|#E2EDF8" />
                        <ComboBoxItem Content="浅色 · 绿色" Tag="Light|#E0F1E7" />
                        <ComboBoxItem Content="浅色 · 粉色" Tag="Light|#F4E2E8" />
                    </ComboBox>
                </Grid>
            </TabItem>
            <TabItem Header="PDF">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="PDF 会按源文件顺序创建真实页面，并保留原始尺寸和源文件。" Foreground="#B9B9B9" TextWrapping="Wrap" />
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="PdfPathInput" IsReadOnly="True" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="选择 PDF" Click="OnBrowsePdf" />
                    </Grid>
                    <Border Grid.Row="2" Margin="0,18,0,0" Padding="14" Background="#232323" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <TextBlock Text="导入结果" FontWeight="SemiBold" />
                            <TextBlock Text="每个 PDF 页成为一个可单独批注、搜索和导出的页面；源页面作为不可误选的底层对象。" Foreground="#B9B9B9" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True" />
            <Button Content="创建" IsDefault="True" Background="#374048" BorderBrush="#DAB2E9" Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
