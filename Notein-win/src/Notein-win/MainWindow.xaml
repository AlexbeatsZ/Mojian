<Window x:Class="Notein_win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Notein_win.ViewModels"
        xmlns:models="clr-namespace:Notein_win.Models"
        xmlns:controls="clr-namespace:Notein_win.Controls"
        mc:Ignorable="d"
        Title="Notein-win"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource WindowBackground}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <!-- PRIMARY WORKSPACE CONTENT -->
        <DockPanel Visibility="{Binding IsBackstageOpen, Converter={x:Null}}">
            
            <!-- TOP TITLE BAR & RIBBON AREA (Normal Chrome) -->
            <StackPanel DockPanel.Dock="Top" Background="{StaticResource TitleBarBackground}"
                        Visibility="{Binding IsNormalChromeVisible, Converter={x:Null}}">
                
                <!-- Window Title / Ribbon Tabs Row -->
                <Grid Height="38" Background="{StaticResource TitleBarBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Backstage File Button -->
                    <Button Grid.Column="0" Content="文件"
                            Command="{Binding OpenBackstageCommand}"
                            Background="{StaticResource AccentPurple}"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="16,6"
                            Margin="8,4,12,4"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Ribbon Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <RadioButton Content="开始" Style="{StaticResource RibbonTabButtonStyle}"
                                     IsChecked="{Binding ActiveRibbonTab, ConverterParameter={x:Static models:RibbonTab.Home}, Mode=OneWay}"
                                     Command="{Binding SelectRibbonTabCommand}" CommandParameter="{x:Static models:RibbonTab.Home}" />
                        <RadioButton Content="插入" Style="{StaticResource RibbonTabButtonStyle}"
                                     IsChecked="{Binding ActiveRibbonTab, ConverterParameter={x:Static models:RibbonTab.Insert}, Mode=OneWay}"
                                     Command="{Binding SelectRibbonTabCommand}" CommandParameter="{x:Static models:RibbonTab.Insert}" />
                        <RadioButton Content="绘图" Style="{StaticResource RibbonTabButtonStyle}"
                                     IsChecked="{Binding ActiveRibbonTab, ConverterParameter={x:Static models:RibbonTab.Draw}, Mode=OneWay}"
                                     Command="{Binding SelectRibbonTabCommand}" CommandParameter="{x:Static models:RibbonTab.Draw}" />
                        <RadioButton Content="视图" Style="{StaticResource RibbonTabButtonStyle}"
                                     IsChecked="{Binding ActiveRibbonTab, ConverterParameter={x:Static models:RibbonTab.View}, Mode=OneWay}"
                                     Command="{Binding SelectRibbonTabCommand}" CommandParameter="{x:Static models:RibbonTab.View}" />
                    </StackPanel>

                    <!-- Top Right Context Controls: Breadcrumb & FullPage -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BreadcrumbText}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="进入全页模式" Command="{Binding ToggleFullPageCommand}">
                            <Path Data="{StaticResource IconFullPage}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- RIBBON ACTION PANEL -->
                <Border Height="52" Background="{StaticResource RibbonBackground}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,1,0,1">
                    <Grid>
                        <!-- 1. HOME RIBBON PANEL -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                
                                <!-- Clipboard Group -->
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="粘贴">
                                    <Path Data="{StaticResource IconPaste}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="剪切">
                                    <Path Data="{StaticResource IconCut}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="复制">
                                    <Path Data="{StaticResource IconCopy}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>

                                <Border Style="{StaticResource HairlineVerticalSeparator}" />

                                <!-- Formatting Group -->
                                <ToggleButton Style="{StaticResource RibbonToggleButtonStyle}" ToolTip="加粗">
                                    <Path Data="{StaticResource IconBold}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="14" Height="14" />
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource RibbonToggleButtonStyle}" ToolTip="倾斜">
                                    <Path Data="{StaticResource IconItalic}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="14" Height="14" />
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource RibbonToggleButtonStyle}" ToolTip="下划线">
                                    <Path Data="{StaticResource IconUnderline}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="14" Height="14" />
                                </ToggleButton>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="项目符号">
                                    <Path Data="{StaticResource IconBullets}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="15" Height="15" />
                                </Button>

                                <Border Style="{StaticResource HairlineVerticalSeparator}" />

                                <!-- Tags Group -->
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="重要标记 (星标)"
                                        Command="{Binding ArmTagPlacementCommand}" CommandParameter="{x:Static models:CanvasTagKind.Important}">
                                    <Path Data="{StaticResource IconStar}" Fill="{StaticResource TagRed}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="问题标记 (问号)"
                                        Command="{Binding ArmTagPlacementCommand}" CommandParameter="{x:Static models:CanvasTagKind.Question}">
                                    <Path Data="{StaticResource IconQuestion}" Fill="{StaticResource TagRed}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>

                                <Border Style="{StaticResource HairlineVerticalSeparator}" />

                                <!-- Insert Objects Group -->
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="插入表格" Click="OnInsertTableClick">
                                    <Path Data="{StaticResource IconTable}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="插入附件" Click="OnInsertAttachmentClick">
                                    <Path Data="{StaticResource IconAttachment}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="插入图片" Click="OnInsertImageClick">
                                    <Path Data="{StaticResource IconImage}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="插入电子表格" Click="OnInsertSpreadsheetClick">
                                    <Path Data="{StaticResource IconSpreadsheet}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="插入笔记链接" Click="OnInsertLinkClick">
                                    <Path Data="{StaticResource IconLink}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>

                                <Border Style="{StaticResource HairlineVerticalSeparator}" />

                                <!-- Draw Tools Group -->
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="撤销" Command="{Binding UndoCommand}">
                                    <Path Data="{StaticResource IconUndo}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                                <ToggleButton Style="{StaticResource RibbonToggleButtonStyle}" ToolTip="文本光标模式"
                                              IsChecked="{Binding TextModeEnabled, Mode=TwoWay}">
                                    <Path Data="{StaticResource IconCursor}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </ToggleButton>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="套索选择"
                                        Command="{Binding SelectToolCommand}" CommandParameter="lasso-freeform">
                                    <Path Data="{StaticResource IconLasso}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="橡皮擦"
                                        Command="{Binding SelectToolCommand}" CommandParameter="eraser-stroke">
                                    <Path Data="{StaticResource IconEraser}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>

                                <!-- Pen Presets from Shelf -->
                                <ItemsControl ItemsSource="{Binding Tools}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RibbonIconButtonStyle}"
                                                    ToolTip="{Binding DisplayName}"
                                                    Command="{Binding DataContext.SelectToolCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}">
                                                <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource BorderHairline}">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding Color, Converter={x:Null}}" />
                                                    </Border.Background>
                                                    <Path Data="{StaticResource IconPen}" Fill="White" Stretch="Uniform" Width="10" Height="10" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="添加笔"
                                        Command="{Binding AddToolCommand}" CommandParameter="{x:Static models:DrawingToolKind.Pen}">
                                    <Path Data="{StaticResource IconAdd}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="14" Height="14" />
                                </Button>

                                <Border Style="{StaticResource HairlineVerticalSeparator}" />

                                <!-- Hand & Canvas Utilities -->
                                <ToggleButton Style="{StaticResource RibbonToggleButtonStyle}" ToolTip="全景漫游手势"
                                              IsChecked="{Binding SingleFingerPanEnabled, Mode=TwoWay}">
                                    <Path Data="{StaticResource IconHand}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource RibbonToggleButtonStyle}" ToolTip="插入垂直空间"
                                              IsChecked="{Binding InsertSpaceModeEnabled, Mode=TwoWay}">
                                    <Path Data="{StaticResource IconInsertSpace}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </ToggleButton>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="背景网格格式" Click="OnBackgroundFormatClick">
                                    <Path Data="{StaticResource IconGrid}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="清除页面" Command="{Binding ClearPageCommand}">
                                    <Path Data="{StaticResource IconClear}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                </Button>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- MAIN WORKSPACE ROW -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 1. Vertical 32px Rail -->
                    <ColumnDefinition Width="32" />
                    <!-- 2. Black Section Pane (196px) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 3. Gray Page Pane (196px) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 4. Canvas Viewport Area -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. VERTICAL NAVIGATION RAIL (32px) -->
                <Border Grid.Column="0" Background="{StaticResource RailBackground}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,8,0,0">
                        <ToggleButton Style="{StaticResource RailToggleButtonStyle}" ToolTip="切换分区窗格"
                                      IsChecked="{Binding IsSectionPaneVisible, Mode=TwoWay}">
                            <Path Data="{StaticResource IconNavigation}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" Width="14" Height="14" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource RailToggleButtonStyle}" ToolTip="切换页面窗格"
                                      IsChecked="{Binding IsPagePaneVisible, Mode=TwoWay}">
                            <Path Data="{StaticResource IconPanelLeft}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" Width="14" Height="14" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 2. BLACK SECTION PANE (196px) -->
                <Border Grid.Column="1" Width="196" Background="{StaticResource SectionPaneBackground}"
                        BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0"
                        Visibility="{Binding IsSectionPaneVisible, Converter={x:Null}}">
                    <DockPanel>
                        <!-- Section Pane Header -->
                        <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource SectionPaneBackground}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="8,0,8,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource RibbonIconButtonStyle}" Width="28" Height="28" Padding="4"
                                        ToolTip="新建分区/笔记本" Click="OnAddSectionMenuClick">
                                    <Path Data="{StaticResource IconAdd}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="14" Height="14" />
                                </Button>
                                <Button DockPanel.Dock="Left" Content="{Binding ActiveNotebookTitle}"
                                        Command="{Binding FocusNotebookRootCommand}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand" />
                            </DockPanel>
                        </Border>

                        <!-- Recursive Section Tree Items -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SectionRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="32" Margin="0,1" CornerRadius="3" Background="Transparent" Cursor="Hand">
                                            <Grid>
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Section.Id}" />
                                                </Grid.InputBindings>
                                                <DockPanel Margin="{Binding Depth, Converter={x:Null}}">
                                                    <Button DockPanel.Dock="Left" Width="20" Height="20" Background="Transparent" BorderThickness="0"
                                                            Command="{Binding DataContext.ToggleSectionExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Section.Id}"
                                                            Visibility="{Binding Section.Children.Count, Converter={x:Null}}">
                                                        <Path Data="{StaticResource IconChevronDown}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" Width="10" Height="10" />
                                                    </Button>
                                                    <TextBlock Text="{Binding Section.Title}" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 3. GRAY PAGE PANE (196px) -->
                <Border Grid.Column="2" Width="196" Background="{StaticResource PagePaneBackground}"
                        BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0"
                        Visibility="{Binding IsPagePaneVisible, Converter={x:Null}}">
                    <DockPanel>
                        <!-- Add Page Button -->
                        <Border DockPanel.Dock="Top" Height="36" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1">
                            <Button Content="+ 添加页面"
                                    Command="{Binding AddPageCommand}"
                                    IsEnabled="{Binding CanAddPage}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                                    HorizontalAlignment="Left" Margin="12,0,0,0" Cursor="Hand" />
                        </Border>

                        <!-- Page List -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PagePaneRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="44" Padding="12,4" Margin="0,1" CornerRadius="3" Background="Transparent" Cursor="Hand">
                                            <Grid>
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                </Grid.InputBindings>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Page.Title}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Page.Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 4. CANVAS VIEWPORT -->
                <Grid Grid.Column="3">
                    <controls:NoteCanvas x:Name="CanvasControl"
                                         BackgroundFormat="{Binding BackgroundFormat}"
                                         SelectedTool="{Binding SelectedTool}"
                                         SingleFingerPanEnabled="{Binding SingleFingerPanEnabled}"
                                         TextModeEnabled="{Binding TextModeEnabled}"
                                         InsertSpaceModeEnabled="{Binding InsertSpaceModeEnabled}"
                                         PendingTagKind="{Binding PendingTagKind}" />

                    <!-- FULL-PAGE FLOATING QUICK TOOLBAR -->
                    <Border Visibility="{Binding IsFullPageMode, Converter={x:Null}}"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,16,0,0" Background="{StaticResource TitleBarBackground}"
                            BorderBrush="{StaticResource BorderHairline}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="撤销" Command="{Binding UndoCommand}">
                                <Path Data="{StaticResource IconUndo}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="14" Height="14" />
                            </Button>
                            <ToggleButton Style="{StaticResource RibbonToggleButtonStyle}" ToolTip="光标" IsChecked="{Binding TextModeEnabled, Mode=TwoWay}">
                                <Path Data="{StaticResource IconCursor}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="14" Height="14" />
                            </ToggleButton>
                            <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="黑笔" Command="{Binding SelectToolCommand}" CommandParameter="pen-black">
                                <Path Data="{StaticResource IconPen}" Fill="White" Stretch="Uniform" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="蓝笔" Command="{Binding SelectToolCommand}" CommandParameter="pen-blue">
                                <Path Data="{StaticResource IconPen}" Fill="{StaticResource AccentBlue}" Stretch="Uniform" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="红笔" Command="{Binding SelectToolCommand}" CommandParameter="pen-red">
                                <Path Data="{StaticResource IconPen}" Fill="{StaticResource TagRed}" Stretch="Uniform" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="橡皮" Command="{Binding SelectToolCommand}" CommandParameter="eraser-stroke">
                                <Path Data="{StaticResource IconEraser}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="14" Height="14" />
                            </Button>
                            <Border Style="{StaticResource HairlineVerticalSeparator}" />
                            <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="退出全页模式" Command="{Binding ToggleFullPageCommand}">
                                <Path Data="{StaticResource IconExitFullPage}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="14" Height="14" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- FULL-SCREEN BACKSTAGE OVERLAY -->
        <controls:BackstageView Visibility="{Binding IsBackstageOpen, Converter={x:Null}}" />
    </Grid>
</Window>
