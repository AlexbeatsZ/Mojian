{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mojian pen configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "name",
    "style"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "mojian-pen/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,80}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "parameters": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_]{1,40}$"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter",
          "label",
          "min",
          "max",
          "step"
        ],
        "properties": {
          "parameter": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,40}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "maxLength": 12
          },
          "legacyField": {
            "enum": [
              "pressurePercent",
              "inkFlowPercent",
              "stabilityPercent"
            ]
          }
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pressureEnabled": {
          "type": "boolean"
        },
        "pressureCurve": {
          "$ref": "#/$defs/curve"
        },
        "speedEnabled": {
          "type": "boolean"
        },
        "speedCurve": {
          "$ref": "#/$defs/curve"
        },
        "directionEnabled": {
          "type": "boolean"
        },
        "directionAmount": {
          "$ref": "#/$defs/expression"
        },
        "startEnabled": {
          "type": "boolean"
        },
        "startLengthMm": {
          "$ref": "#/$defs/expression"
        },
        "startMinimum": {
          "$ref": "#/$defs/expression"
        },
        "endEnabled": {
          "type": "boolean"
        },
        "endLengthMm": {
          "$ref": "#/$defs/expression"
        },
        "endMinimum": {
          "$ref": "#/$defs/expression"
        },
        "stabilityPercent": {
          "$ref": "#/$defs/expression"
        },
        "tiltEnabled": {
          "type": "boolean"
        },
        "tiltWidth": {
          "$ref": "#/$defs/expression"
        },
        "turnEnabled": {
          "type": "boolean"
        },
        "turnAmount": {
          "$ref": "#/$defs/expression"
        },
        "pressureResponseMs": {
          "$ref": "#/$defs/expression"
        },
        "speedResponseMs": {
          "$ref": "#/$defs/expression"
        },
        "directionResponseMs": {
          "$ref": "#/$defs/expression"
        },
        "speedMaximumCmPerSecond": {
          "$ref": "#/$defs/expression"
        },
        "directionMinimum": {
          "$ref": "#/$defs/expression"
        },
        "directionMaximum": {
          "$ref": "#/$defs/expression"
        },
        "turnMinimum": {
          "$ref": "#/$defs/expression"
        },
        "turnMaximum": {
          "$ref": "#/$defs/expression"
        },
        "turnResponseMs": {
          "$ref": "#/$defs/expression"
        },
        "tiltMaximumRadians": {
          "$ref": "#/$defs/expression"
        },
        "inputWindowMs": {
          "$ref": "#/$defs/expression"
        },
        "upsamplingHz": {
          "$ref": "#/$defs/expression"
        },
        "startResponseMs": {
          "$ref": "#/$defs/expression"
        },
        "endResponseMs": {
          "$ref": "#/$defs/expression"
        }
      }
    }
  },
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^(x|\\$[A-Za-z0-9_]{1,40})$"
        },
        {
          "$ref": "#/$defs/math"
        },
        {
          "$ref": "#/$defs/piecewise"
        }
      ]
    },
    "math": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "enum": [
            "add",
            "subtract",
            "multiply",
            "divide",
            "pow",
            "min",
            "max",
            "abs",
            "sin",
            "cos",
            "exp",
            "log",
            "clamp",
            "linear",
            "smoothstep"
          ]
        },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/expression"
          }
        }
      }
    },
    "piecewise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "segments"
      ],
      "properties": {
        "op": {
          "const": "piecewise"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "value"
            ],
            "properties": {
              "from": {
                "type": "number"
              },
              "to": {
                "type": "number"
              },
              "value": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      }
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function"
      ],
      "properties": {
        "function": {
          "$ref": "#/$defs/expression"
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256,
          "default": 128
        },
        "breaks": {
          "type": "array",
          "maxItems": 257,
          "uniqueItems": true,
          "items": {
            "type": "number"
          }
        }
      }
    }
  }
}
