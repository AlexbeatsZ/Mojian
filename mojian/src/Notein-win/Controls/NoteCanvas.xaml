<UserControl x:Class="Notein_win.Controls.NoteCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Notein_win.Controls"
             Focusable="True"
             IsManipulationEnabled="True"
             ClipToBounds="True">
    <Grid Background="#0A0A0A">
        <local:CanvasDocumentScene x:Name="SceneLayer" IsHitTestVisible="False" ClipToBounds="True" />
        <local:CanvasWetInkOverlay x:Name="WetInkOverlay" IsHitTestVisible="False" />
        <Canvas x:Name="EditorLayer" Background="Transparent" />
        <local:CanvasPointerOverlay x:Name="PointerOverlay" IsHitTestVisible="False" />
    </Grid>
</UserControl>
