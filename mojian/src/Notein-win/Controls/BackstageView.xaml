<UserControl x:Class="Notein_win.Controls.BackstageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Notein_win.Models"
             xmlns:controls="clr-namespace:Notein_win.Controls"
             xmlns:vm="clr-namespace:Notein_win.ViewModels"
             Background="{StaticResource WindowBackground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <vm:FluentIconConverter x:Key="FluentIcon" />
        <Style x:Key="BackstageNav" TargetType="RadioButton" BasedOn="{StaticResource RibbonTabButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <Style x:Key="ActionCard" TargetType="Button">
            <Setter Property="Background" Value="#232323" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="BackstageNavigationColumn" Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource TitleBarBackground}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,14">
                <Button DockPanel.Dock="Top" Command="{Binding CloseBackstageCommand}" Style="{StaticResource RibbonIconButtonStyle}" HorizontalAlignment="Left" Margin="8,0,0,8" Width="136" Height="42" ToolTip="返回">
                    <Path Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" Fill="{StaticResource TextPrimary}" Width="18" Height="18" />
                </Button>
                <StackPanel>
                    <RadioButton Content="信息" Style="{StaticResource BackstageNav}" IsChecked="{Binding IsBackstageInfo, Mode=OneWay}" Command="{Binding SelectBackstageTabCommand}" CommandParameter="Info" />
                    <RadioButton Content="新建" Style="{StaticResource BackstageNav}" IsChecked="{Binding IsBackstageNew, Mode=OneWay}" Command="{Binding SelectBackstageTabCommand}" CommandParameter="New" />
                    <RadioButton Content="打开" Style="{StaticResource BackstageNav}" IsChecked="{Binding IsBackstageOpenPage, Mode=OneWay}" Command="{Binding SelectBackstageTabCommand}" CommandParameter="Open" />
                    <Border Height="1" Background="{StaticResource BorderHairline}" Margin="12,8" />
                    <RadioButton Content="保存副本" Style="{StaticResource BackstageNav}" IsChecked="{Binding IsBackstageSaveCopy, Mode=OneWay}" Command="{Binding SelectBackstageTabCommand}" CommandParameter="SaveCopy" />
                    <RadioButton Content="打印" Style="{StaticResource BackstageNav}" IsChecked="{Binding IsBackstagePrint, Mode=OneWay}" Command="{Binding SelectBackstageTabCommand}" CommandParameter="Print" />
                    <RadioButton Content="共享" Style="{StaticResource BackstageNav}" IsChecked="{Binding IsBackstageShare, Mode=OneWay}" Command="{Binding SelectBackstageTabCommand}" CommandParameter="Share" />
                    <RadioButton Content="导出" Style="{StaticResource BackstageNav}" IsChecked="{Binding IsBackstageExport, Mode=OneWay}" Command="{Binding SelectBackstageTabCommand}" CommandParameter="Export" />
                    <RadioButton Content="帐户" Style="{StaticResource BackstageNav}" IsChecked="{Binding IsBackstageAccount, Mode=OneWay}" Command="{Binding SelectBackstageTabCommand}" CommandParameter="Account" Margin="8,28,8,2" />
                    <RadioButton Content="快捷键" Style="{StaticResource BackstageNav}" IsChecked="{Binding IsBackstageShortcuts, Mode=OneWay}" Command="{Binding SelectBackstageTabCommand}" CommandParameter="Shortcuts" />
                    <RadioButton Content="选项" Style="{StaticResource BackstageNav}" IsChecked="{Binding IsBackstageOptions, Mode=OneWay}" Command="{Binding SelectBackstageTabCommand}" CommandParameter="Options" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="36,26">
            <Grid MaxWidth="920" HorizontalAlignment="Left">
                <StackPanel Visibility="{Binding IsBackstageInfo, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="工作区信息" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,22" />
                    <Border Background="#232323" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="3" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveNotebookTitle}" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BreadcrumbText}" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,18" />
                            <TextBlock Text="本地工作区" Foreground="{StaticResource TextMuted}" FontSize="11" />
                            <TextBlock Text="{Binding WorkspaceRoot}" Foreground="{StaticResource TextPrimary}" FontFamily="Cascadia Mono" TextWrapping="Wrap" Margin="0,4,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="打开文件夹" Style="{StaticResource ActionCard}" Width="140" Click="OnOpenWorkspaceClick" />
                                <Button Content="切换工作区" Style="{StaticResource ActionCard}" Width="140" Margin="8,4,0,4" Click="OnSwitchWorkspaceClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="笔记本" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,8" />
                    <ItemsControl ItemsSource="{Binding Library.Notebooks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ActionCard}" Command="{Binding DataContext.SelectNotebookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="打开" Foreground="{StaticResource AccentPurple}" /><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /></DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding IsBackstageNew, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="新建" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,22" />
                    <Button Style="{StaticResource ActionCard}" Click="OnNewNotebookClick">
                        <StackPanel><TextBlock Text="新建笔记本" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="创建一个带“未归档”分区和空白页面的本地笔记本" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" /></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Visibility="{Binding IsBackstageOpenPage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="打开" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,22" />
                    <Button Style="{StaticResource ActionCard}" Click="OnSwitchWorkspaceClick"><StackPanel><TextBlock Text="打开本地工作区" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="选择一个墨笺工作区文件夹" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" /></StackPanel></Button>
                </StackPanel>

                <StackPanel Visibility="{Binding IsBackstageSaveCopy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="保存副本" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,22" />
                    <Button Style="{StaticResource ActionCard}" Click="OnExportPackageClick"><StackPanel><TextBlock Text="保存笔记本副本 (.mjn)" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="包含可编辑页面、原始附件和页面资产" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" /></StackPanel></Button>
                </StackPanel>

                <controls:ExportPanel x:Name="PrintSettings" Visibility="{Binding IsBackstagePrint, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Visibility="{Binding IsBackstageShare, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="共享" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,22" />
                    <Button Style="{StaticResource ActionCard}" Click="OnExportPackageClick"><StackPanel><TextBlock Text="导出可共享副本" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="先保存本地 .mjn，再使用 Windows 的共享方式发送" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" /></StackPanel></Button>
                </StackPanel>

                <controls:ExportPanel x:Name="ExportSettings" Visibility="{Binding IsBackstageExport, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Visibility="{Binding IsBackstageToolbar, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="全页快捷工具栏" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,22" />
                    <TextBlock Text="点击“添加”会把按钮放到快捷栏末尾；点击“移除”会立即从整页视图隐藏。" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="680" Margin="0,0,0,16" />
                    <TextBlock Text="当前按钮" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding FullPageToolbarItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#2B2B2B" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" Margin="0,2" Padding="10,5"><DockPanel><Button DockPanel.Dock="Right" Content="移除" Style="{StaticResource RibbonIconButtonStyle}" Command="{Binding DataContext.ToggleFullPageToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" /><Path DockPanel.Dock="Left" Data="{Binding IconKey, Converter={StaticResource FluentIcon}}" Fill="{Binding TintHex}" Width="22" Height="22" Margin="0,0,12,0" /><TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" /></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="可添加按钮" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
                    <ItemsControl ItemsSource="{Binding FullPageToolbarAvailableItems}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1" Padding="10,5"><DockPanel><Button DockPanel.Dock="Right" Content="添加" Foreground="{StaticResource AccentPurple}" Style="{StaticResource RibbonIconButtonStyle}" Command="{Binding DataContext.ToggleFullPageToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" /><Path DockPanel.Dock="Left" Data="{Binding IconKey, Converter={StaticResource FluentIcon}}" Fill="{Binding TintHex}" Width="22" Height="22" Margin="0,0,12,0" /><TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" /></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding IsBackstageAccount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="帐户" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,22" />
                    <TextBlock Text="墨笺当前使用本地工作区，不需要登录帐户。" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsBackstageShortcuts, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="快捷键" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="按照顶部功能区分类。这里只列出按下后可立即执行的操作；设置重复按键时，旧映射会自动清除。" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="720" Margin="0,0,0,18" />
                    <TextBlock Text="鼠标/笔预设：按住中键移动画布；同时按 Ctrl 后向右下放大、向左上缩小；按住右键拖动临时套索。" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="720" Margin="0,0,0,18" />
                    <ItemsControl ItemsSource="{Binding ShortcutGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,22">
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Actions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1" Padding="8,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="64" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding GestureText}" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" FontFamily="Cascadia Mono" />
                                                        <Button Grid.Column="2" Content="设置" Style="{StaticResource RibbonIconButtonStyle}" Tag="{Binding}" Click="OnConfigureShortcutClick" />
                                                        <Button Grid.Column="3" Content="清除" Style="{StaticResource RibbonIconButtonStyle}" Tag="{Binding}" Click="OnClearShortcutClick" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding IsBackstageOptions, Converter={StaticResource BoolToVisibility}}" MaxWidth="820">
                    <TextBlock Text="墨笺选项" Foreground="{StaticResource TextPrimary}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24" />
                    
                    <!-- Section 1: 绘图与页面 -->
                    <TextBlock Text="绘图与页面" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border Height="1" Background="{StaticResource BorderHairline}" Margin="0,0,0,12" />

                    <!-- Row 1: 笔迹预测 -->
                    <Border MinHeight="56" Padding="0,8">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{Binding PredictionButtonText}" Command="{Binding TogglePredictionCommand}"
                                    Style="{StaticResource ActionCard}" Width="100" Height="36" HorizontalContentAlignment="Center" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="笔迹预测" Foreground="{StaticResource TextPrimary}" FontSize="14" />
                                <TextBlock Text="使用预测触点降低快速书写时的视觉延迟。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Row 2: 页面栏显示范围 -->
                    <Border MinHeight="56" Padding="0,8">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{Binding PagePaneModeButtonText}" Command="{Binding TogglePagePaneModeCommand}"
                                    Style="{StaticResource ActionCard}" Width="100" Height="36" HorizontalContentAlignment="Center" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="页面栏显示范围" Foreground="{StaticResource TextPrimary}" FontSize="14" />
                                <TextBlock Text="本层只显示当前分区页面；递归还显示所有子分区及其页面。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Row 3: 图片导入显示 -->
                    <Border MinHeight="56" Padding="0,8" Visibility="{Binding IsDarkPageBackground, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{Binding ImageDisplayModeButtonText}" Command="{Binding CycleImageDisplayModeCommand}"
                                    Style="{StaticResource ActionCard}" Width="100" Height="36" HorizontalContentAlignment="Center" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="暗色模式图片导入" Foreground="{StaticResource TextPrimary}" FontSize="14" />
                                <TextBlock Text="默认自动反色，不询问；可改为询问或保持原图。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Row 4: PDF 打印样式显示 -->
                    <Border MinHeight="56" Padding="0,8" Visibility="{Binding IsDarkPageBackground, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{Binding PdfDisplayModeButtonText}" Command="{Binding CyclePdfDisplayModeCommand}"
                                    Style="{StaticResource ActionCard}" Width="100" Height="36" HorizontalContentAlignment="Center" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="暗色模式 PDF 插图" Foreground="{StaticResource TextPrimary}" FontSize="14" />
                                <TextBlock Text="逐页插入时的显示方式；保留原始 PDF 文件。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Section 2: 整页视图 -->
                    <TextBlock Text="整页视图" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,6" />
                    <Border Height="1" Background="{StaticResource BorderHairline}" Margin="0,0,0,12" />

                    <!-- Row 1: 快捷工具栏 -->
                    <Border MinHeight="56" Padding="0,8">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="配置" Command="{Binding SelectBackstageTabCommand}" CommandParameter="Toolbar"
                                    Style="{StaticResource ActionCard}" Width="100" Height="36" HorizontalContentAlignment="Center" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="快捷工具栏" Foreground="{StaticResource TextPrimary}" FontSize="14" />
                                <TextBlock Text="添加或移除任意开始、绘图按钮；整页视图中可横向滑动使用。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
