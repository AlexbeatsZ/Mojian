<Window x:Class="Notein_win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Notein_win.Models"
        xmlns:controls="clr-namespace:Notein_win.Controls"
        xmlns:vm="clr-namespace:Notein_win.ViewModels"
        Title="墨笺" Height="820" Width="1280" MinHeight="620" MinWidth="920"
        Icon="Assets/mojian.png"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated"
        Closing="OnWindowClosing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <vm:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <vm:BooleanToGridLengthConverter x:Key="BoolToGridLength" />
        <vm:ShapeLabelConverter x:Key="ShapeLabelConverter" />
        <vm:FluentIconConverter x:Key="FluentIcon" />
        <vm:FluentDrawingIconConverter x:Key="FluentDrawingIcon" />
        <Style x:Key="ShapeChooserStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F4F4" />
            <Setter Property="Background" Value="#303030" />
            <Setter Property="Height" Value="32" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F4F4F4" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Template">
                            <Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#374048" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#374048" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#303030" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="2" /></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Path Data="M0,0L4,4L8,0" Stroke="#B9B9B9" StrokeThickness="1.5" Width="8" Height="4" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom" Focusable="False">
                            <Border Background="#232323" BorderBrush="#4A4A4A" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="320"><ItemsPresenter /></ScrollViewer></Border>
                        </Popup>
                    </Grid>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="5,1" />
            <Setter Property="MinHeight" Value="40" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedOverlay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotebookPaneRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="5,1" />
            <Setter Property="Height" Value="40" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedOverlay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavigationChevronButton" TargetType="Button" BasedOn="{StaticResource RibbonIconButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- One vector chevron rotated 90 degrees when expanded, so both states share size, weight and center. -->
        <Style x:Key="NavigationChevronGlyph" TargetType="Viewbox">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeDropdownButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonIconButtonStyle}">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="9,0,5,0" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <Style x:Key="AndroidCommandToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource RibbonToggleButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="ToolPresetToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="chevron" Data="{StaticResource Fluent_caret_down}" Fill="{StaticResource AccentPurple}"
                                      Width="8" Height="4" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Margin="0,0,4,4" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource HoverOverlay}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SelectedOverlay}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
                                <Setter TargetName="chevron" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource AccentPurple}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- App-drawn caption buttons inside the 34 px top row; glyphs are the OS caption font codepoints. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <TextBlock x:Name="glyph" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextRenderingMode="Grayscale" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#2D2D2D" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#3A3A3A" /></Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="Tag" Value="Close" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#C42B1C" />
                                <Setter TargetName="glyph" Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="Tag" Value="Close" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#A8271A" />
                                <Setter TargetName="glyph" Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="glyph" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootLayout">
        <DockPanel Visibility="{Binding IsBackstageOpen, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel DockPanel.Dock="Top" Background="{StaticResource RibbonBackground}"
                        Visibility="{Binding IsNormalChromeVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid Height="34" Background="{StaticResource RibbonBackground}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="文件" Style="{StaticResource RibbonFileButtonStyle}" Command="{Binding OpenBackstageCommand}" />
                        <RadioButton Content="开始" Style="{StaticResource RibbonTabButtonStyle}" IsChecked="{Binding IsHomeRibbonVisible, Mode=OneWay}" Command="{Binding SelectRibbonTabCommand}" CommandParameter="{x:Static models:RibbonTab.Home}" />
                        <RadioButton Content="插入" Style="{StaticResource RibbonTabButtonStyle}" IsChecked="{Binding IsInsertRibbonVisible, Mode=OneWay}" Command="{Binding SelectRibbonTabCommand}" CommandParameter="{x:Static models:RibbonTab.Insert}" />
                        <RadioButton Content="绘图" Style="{StaticResource RibbonTabButtonStyle}" IsChecked="{Binding IsDrawRibbonVisible, Mode=OneWay}" Command="{Binding SelectRibbonTabCommand}" CommandParameter="{x:Static models:RibbonTab.Draw}" />
                        <RadioButton Content="视图" Style="{StaticResource RibbonTabButtonStyle}" IsChecked="{Binding IsViewRibbonVisible, Mode=OneWay}" Command="{Binding SelectRibbonTabCommand}" CommandParameter="{x:Static models:RibbonTab.View}" />
                    </StackPanel>
                </Grid>

                <Border Height="50" Background="{StaticResource ToolbarBackground}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,1,0,1">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsHomeRibbonVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="6,2,8,2">
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="粘贴" Tag="Paste" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_clipboard_paste}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="剪切" Tag="Cut" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_cut}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="复制" Tag="Copy" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_copy}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="18" Height="42" Margin="0" ToolTip="复制选项" Click="OnCopyOptionsClick"><Path Data="{StaticResource Fluent_caret_down}" Fill="{StaticResource TextPrimary}" Width="9" Height="5" Stretch="Uniform" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="格式刷" Tag="FormatPainter" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_paint_brush}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <Button Style="{StaticResource HomeDropdownButtonStyle}" Width="90" ToolTip="字体" Tag="FontFamily" Click="OnHomeCommandClick"><DockPanel><Path DockPanel.Dock="Right" Data="{StaticResource Fluent_caret_down}" Fill="{StaticResource TextSecondary}" Width="9" Height="5" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,0,0" /><TextBlock Text="无衬线" FontSize="11" VerticalAlignment="Center" /></DockPanel></Button>
                                <Button Style="{StaticResource HomeDropdownButtonStyle}" Width="52" ToolTip="字号" Tag="FontSize" Click="OnHomeCommandClick"><DockPanel><Path DockPanel.Dock="Right" Data="{StaticResource Fluent_caret_down}" Fill="{StaticResource TextSecondary}" Width="9" Height="5" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,0,0" /><TextBlock Text="16" FontSize="11" VerticalAlignment="Center" /></DockPanel></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="加粗" Tag="Bold" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_bold}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="倾斜" Tag="Italic" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_italic}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="下划线" Tag="Underline" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_underline}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="删除线" Tag="Strikethrough" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_strikethrough}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="字体颜色" Tag="FontColor" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_color}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="文本突出显示" Tag="Highlight" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_highlight_text}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="下标" Tag="Subscript" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_subscript}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="清除所有格式" Tag="ClearFormatting" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_clear_formatting}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="项目符号" Tag="Bullets" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_bullet_list_ltr}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="编号" Tag="Numbering" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_number_list_ltr}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="减少缩进" Tag="IndentDecrease" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_indent_decrease_ltr}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="增加缩进" Tag="IndentIncrease" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_indent_increase_ltr}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="左对齐" Tag="AlignLeft" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_align_left}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="居中" Tag="AlignCenter" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_align_center}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="右对齐" Tag="AlignRight" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_align_right}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="行距" Tag="LineSpacing" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_text_line_spacing}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="标记" Tag="Tag" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_tag}" Fill="{StaticResource TagRed}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="36" Height="42" Margin="0" ToolTip="查找标记" Tag="FindTags" Click="OnHomeCommandClick"><Path Data="{StaticResource Fluent_tag_search}" Fill="{StaticResource TagRed}" Width="21" Height="21" /></Button>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <Button Style="{StaticResource HomeDropdownButtonStyle}" Width="70" ToolTip="样式" Tag="Styles" Click="OnHomeCommandClick"><DockPanel><Path DockPanel.Dock="Right" Data="{StaticResource Fluent_caret_down}" Fill="{StaticResource TextSecondary}" Width="9" Height="5" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,0,0" /><TextBlock Text="样式" FontSize="11" VerticalAlignment="Center" /></DockPanel></Button>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsInsertRibbonVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="6,2,10,2">
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="46" Margin="0" ToolTip="表格" Click="OnInsertTableClick"><Path Data="{StaticResource Fluent_table}" Fill="{StaticResource TextPrimary}" Width="22" Height="22" /></Button>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="46" Margin="0" ToolTip="文件附件" Click="OnInsertAttachmentClick"><Path Data="{StaticResource Fluent_attach}" Fill="{StaticResource TextPrimary}" Width="22" Height="22" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="46" Margin="0" ToolTip="文件打印样式" Click="OnInsertPdfPrintoutClick"><Path Data="{StaticResource Fluent_document_page}" Fill="{StaticResource TextPrimary}" Width="22" Height="22" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="46" Margin="0" ToolTip="电子表格" Click="OnInsertSpreadsheetClick"><Path Data="{StaticResource Fluent_table_simple}" Fill="{StaticResource TextPrimary}" Width="22" Height="22" /></Button>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="46" Margin="0" ToolTip="图片" Click="OnInsertImageClick"><Path Data="{StaticResource Fluent_image}" Fill="{StaticResource TextPrimary}" Width="22" Height="22" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="46" Margin="0" ToolTip="贴纸" Click="OnInsertStickerClick"><Path Data="{StaticResource Fluent_sticker}" Fill="{StaticResource TextPrimary}" Width="22" Height="22" /></Button>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="46" Margin="0" ToolTip="链接" Click="OnInsertLinkClick"><Path Data="{StaticResource Fluent_link}" Fill="{StaticResource TextPrimary}" Width="22" Height="22" /></Button>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsDrawRibbonVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="6,2,8,2">
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="42" Margin="0" ToolTip="撤销" Command="{Binding UndoCommand}"><Path Data="{StaticResource Fluent_arrow_undo}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <ItemsControl ItemsSource="{Binding LassoTools}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Style="{StaticResource ToolPresetToggleButtonStyle}" ToolTip="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=OneWay}" PreviewMouseLeftButtonDown="OnToolPresetPreviewMouseLeftButtonDown" Click="OnToolPresetClick"><Path Data="{StaticResource Fluent_lasso}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="21" Height="21" /></ToggleButton></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <ItemsControl ItemsSource="{Binding EraserTools}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Style="{StaticResource ToolPresetToggleButtonStyle}" ToolTip="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=OneWay}" PreviewMouseLeftButtonDown="OnToolPresetPreviewMouseLeftButtonDown" Click="OnToolPresetClick"><Path Data="{StaticResource Fluent_eraser}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="21" Height="21" /></ToggleButton></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <ItemsControl ItemsSource="{Binding HighlighterTools}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Style="{StaticResource ToolPresetToggleButtonStyle}" ToolTip="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=OneWay}" PreviewMouseLeftButtonDown="OnToolPresetPreviewMouseLeftButtonDown" Click="OnToolPresetClick"><Path Data="{StaticResource Fluent_highlight}" Fill="{Binding DisplayColorHex}" Width="21" Height="21" /></ToggleButton></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <ItemsControl ItemsSource="{Binding PenTools}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Style="{StaticResource ToolPresetToggleButtonStyle}" ToolTip="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=OneWay}" PreviewMouseLeftButtonDown="OnToolPresetPreviewMouseLeftButtonDown" Click="OnToolPresetClick"><Path Data="{StaticResource Fluent_pen}" Fill="{Binding DisplayColorHex}" Width="21" Height="21" /></ToggleButton></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="42" Margin="0,0,3,0" ToolTip="添加" Click="OnAddToolMenuClick"><Path Data="{StaticResource Fluent_add}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <ItemsControl ItemsSource="{Binding ShapeTools}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Style="{StaticResource ToolPresetToggleButtonStyle}" ToolTip="图形（再次点击设置）" IsChecked="{Binding IsSelected, Mode=OneWay}" PreviewMouseLeftButtonDown="OnToolPresetPreviewMouseLeftButtonDown" Click="OnToolPresetClick"><Path Data="{StaticResource Fluent_shapes}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="21" Height="21" /></ToggleButton></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <ToggleButton x:Name="PanoramaToolButton" Style="{StaticResource AndroidCommandToggleButtonStyle}" ToolTip="触控笔抓手（再次点击设置）"
                                              IsChecked="{Binding SingleFingerPanEnabled, Mode=OneWay}" Click="OnPanoramaToolClick"><Path Data="{StaticResource Fluent_hand_left}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="21" Height="21" /></ToggleButton>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <ToggleButton Style="{StaticResource AndroidCommandToggleButtonStyle}" ToolTip="插入空白空间" IsChecked="{Binding InsertSpaceModeEnabled}"><Image Source="{StaticResource FluentDrawing_insert_space}" Width="21" Height="21" Stretch="Uniform" /></ToggleButton>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="42" Margin="0" ToolTip="设置背景格式" Click="OnBackgroundFormatClick"><Image Source="{StaticResource FluentDrawing_rule_lines}" Width="21" Height="21" Stretch="Uniform" /></Button>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="42" Margin="0" ToolTip="清纸" Click="OnClearPageClick"><Path Data="{StaticResource Fluent_delete_dismiss}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsViewRibbonVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="6,2,8,2">
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="42" Margin="0" ToolTip="整页视图" Click="OnEnterFullPageClick"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="{StaticResource Fluent_full_screen_maximize}" Fill="{StaticResource TextPrimary}" /></Canvas></Viewbox></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="42" Margin="0" ToolTip="普通视图" Click="OnExitFullPageClick"><Path Data="{StaticResource Fluent_panel_left}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <ToggleButton Style="{StaticResource AndroidCommandToggleButtonStyle}" ToolTip="拆分视图" IsChecked="{Binding IsSplitView, Mode=OneWay}" Command="{Binding ToggleSplitViewCommand}"><Path Data="{StaticResource Fluent_split_view}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="21" Height="21" /></ToggleButton>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <ToggleButton Style="{StaticResource RibbonToggleButtonStyle}" Width="38" Height="42" Margin="0" ToolTip="锁定显示比例" IsChecked="{Binding ZoomLocked}"><Path Data="{StaticResource Fluent_lock_closed}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></ToggleButton>
                                <Button Style="{StaticResource HomeDropdownButtonStyle}" Width="70" ToolTip="显示比例" Click="OnZoomPercentClick"><DockPanel><Path DockPanel.Dock="Right" Data="{StaticResource Fluent_caret_down}" Fill="{StaticResource TextSecondary}" Width="9" Height="5" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,0,0" /><TextBlock x:Name="ZoomStatus" Text="100%" FontFamily="Cascadia Mono" FontSize="11" VerticalAlignment="Center" /></DockPanel></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="38" Height="42" Margin="0" ToolTip="放大" Click="OnZoomInClick"><Path Data="{StaticResource Fluent_zoom_in}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="38" Height="42" Margin="0" ToolTip="缩小" Click="OnZoomOutClick"><Path Data="{StaticResource Fluent_zoom_out}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="54" Height="34" ToolTip="100%" Click="OnResetZoomClick"><TextBlock Text="100%" Foreground="{StaticResource TextPrimary}" FontFamily="Cascadia Mono" FontSize="10" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="42" Margin="0" ToolTip="页宽" Command="{Binding FitPageWidthCommand}"><Path Data="{StaticResource Fluent_page_width}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <Border Style="{StaticResource HairlineVerticalSeparator}" />
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="42" Margin="0" ToolTip="基准线" Click="OnBackgroundFormatClick"><Image Source="{StaticResource FluentDrawing_rule_lines}" Width="21" Height="21" Stretch="Uniform" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="42" Margin="0" ToolTip="页面颜色" Click="OnPageColorClick"><Ellipse Fill="{Binding ActivePageAppearance.PageColor}" Stroke="{StaticResource BorderHairline}" Width="21" Height="21" /></Button>
                                <Button Style="{StaticResource RibbonIconButtonStyle}" Width="40" Height="42" Margin="0" ToolTip="纸张大小" Click="OnPaperSizeClick"><Path Data="{StaticResource Fluent_document_page}" Fill="{StaticResource TextPrimary}" Width="21" Height="21" /></Button>
                                <ToggleButton Style="{StaticResource AndroidCommandToggleButtonStyle}" ToolTip="隐藏页面标题" IsChecked="{Binding IsPageTitleHidden, Mode=OneWay}" Click="OnTogglePageTitleClick"><Path Data="{StaticResource Fluent_eye_off}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="21" Height="21" /></ToggleButton>
                                <ToggleButton Style="{StaticResource AndroidCommandToggleButtonStyle}" ToolTip="切换背景" IsChecked="{Binding IsDarkPageBackground, Mode=OneWay}" Click="OnTogglePageThemeClick"><Path Data="{StaticResource Fluent_weather_moon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="21" Height="21" /></ToggleButton>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid x:Name="WorkspaceLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="32" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFullPageMode}" Value="True"><Setter Property="Width" Value="0" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource RailBackground}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0"
                        Visibility="{Binding IsNormalChromeVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,6,0,0">
                        <ToggleButton Style="{StaticResource RailToggleButtonStyle}" ToolTip="折叠或展开分区栏" IsChecked="{Binding IsSectionPaneVisible}"><Path Data="{StaticResource Fluent_navigation}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="20" Height="20" /></ToggleButton>
                        <ToggleButton Style="{StaticResource RailToggleButtonStyle}" ToolTip="折叠或展开页面栏" IsChecked="{Binding IsPagePaneVisible}"><Path Data="{StaticResource Fluent_panel_left}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="20" Height="20" /></ToggleButton>
                    </StackPanel>
                </Border>

                <Border x:Name="SectionPane" Grid.Column="1" Width="196" Background="{StaticResource SectionPaneBackground}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0"
                        Visibility="{Binding IsSectionPaneOpen, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="44">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="AddSectionButton" Grid.Column="1" Style="{StaticResource RibbonIconButtonStyle}" Width="38" Height="38" Margin="0,0,7,0" Padding="8"
                                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="新建笔记本或分区" Click="OnAddSectionMenuClick"><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="{StaticResource Fluent_add}" Fill="{StaticResource TextPrimary}" /></Canvas></Viewbox></Button>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding NotebookTreeRows}">
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type models:NotebookPaneRow}">
                                    <Border Style="{StaticResource NotebookPaneRow}" Padding="5,0,7,0" PreviewMouseRightButtonUp="OnNotebookRowRightClick">
                                        <Grid Background="Transparent">
                                            <Grid.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectNotebookCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" /></Grid.InputBindings>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Left" Style="{StaticResource NavigationChevronButton}" Command="{Binding DataContext.ToggleNotebookExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}">
                                                    <Viewbox Style="{StaticResource NavigationChevronGlyph}"><Canvas Width="24" Height="24"><Path Data="{StaticResource Fluent_chevron_right}" Fill="{StaticResource TextPrimary}" Stretch="None" /></Canvas></Viewbox>
                                                </Button>
                                                <Viewbox DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24"><Path Data="{StaticResource Fluent_notebook}" Fill="{Binding AccentBrush}" /></Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Foreground" Value="{StaticResource TextPrimary}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:SectionRow}">
                                        <Border Style="{StaticResource PaneRow}" Padding="{Binding Indent}" PreviewMouseRightButtonUp="OnSectionRowRightClick">
                                            <Grid Background="Transparent">
                                                <Grid.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Section.Id}" /></Grid.InputBindings>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Left" Style="{StaticResource NavigationChevronButton}" Command="{Binding DataContext.ToggleSectionExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Section.Id}" IsHitTestVisible="{Binding HasChildren}" Focusable="{Binding HasChildren}">
                                                        <Viewbox Style="{StaticResource NavigationChevronGlyph}" Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}"><Canvas Width="24" Height="24"><Path Data="{StaticResource Fluent_chevron_right}" Fill="{StaticResource TextSecondary}" Stretch="None" /></Canvas></Viewbox>
                                                    </Button>
                                                    <Border DockPanel.Dock="Left" Width="4" Height="22" Background="{Binding SectionColorBrush}" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Section.Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentPurple}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border x:Name="PagePane" Grid.Column="2" Width="196" Background="{StaticResource PagePaneBackground}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0"
                        Visibility="{Binding IsPagePaneOpen, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="48">
                            <Button x:Name="AddPageButton" Style="{StaticResource RibbonIconButtonStyle}" Width="38" Height="38" Padding="8" HorizontalAlignment="Right" Margin="0,0,6,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="新建页面" IsEnabled="{Binding CanAddPage}" Click="OnAddPageClick">
                                <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="{StaticResource Fluent_add}" Fill="{StaticResource TextPrimary}" /></Canvas></Viewbox>
                            </Button>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PagePaneRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="{Binding Margin}" Padding="{Binding Indent}" CornerRadius="2" PreviewMouseRightButtonUp="OnPageRowRightClick">
                                            <Grid Background="Transparent">
                                                <Grid.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></Grid.InputBindings>
                                                <DockPanel Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <TextBlock DockPanel.Dock="Right" Text="PDF" Foreground="#828282" FontSize="9" FontWeight="SemiBold" Width="30" TextAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsPdf, Converter={StaticResource BoolToVisibility}}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DockPanel Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibility}}">
                                                    <Border DockPanel.Dock="Left" Width="3" Height="18" Background="{Binding SectionColorBrush}" CornerRadius="1" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Grid>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="MinHeight" Value="58" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SelectedOverlay}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                            <Setter Property="MinHeight" Value="32" />
                                                            <Setter Property="Background" Value="#232323" />
                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="3" Background="#0A0A0A">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding IsSplitView, Converter={StaticResource BoolToGridLength}}" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" PreviewMouseDown="OnLeftCanvasFocus">
                        <controls:NoteCanvas x:Name="LeftCanvas" Document="{Binding PrimaryDocument}" Appearance="{Binding PrimaryPageAppearance}" PageTitle="{Binding PrimaryPageTitle}"
                                             SelectedTool="{Binding SelectedTool}" SingleFingerPanEnabled="{Binding SingleFingerPanEnabled}"
                                             PanoramaSensitivity="{Binding PanoramaSensitivity}" InsertSpaceModeEnabled="{Binding InsertSpaceModeEnabled}" PendingTagKind="{Binding PendingTagKind, Mode=TwoWay}" ZoomLocked="{Binding ZoomLocked}" PredictionEnabled="{Binding PredictionEnabled}" />
                    </Border>
                    <Border Grid.Column="1" Width="7" Background="#2A2A2A" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1,0" Visibility="{Binding IsSplitView, Converter={StaticResource BoolToVisibility}}" />
                    <Border Grid.Column="2" PreviewMouseDown="OnRightCanvasFocus" Visibility="{Binding IsSplitView, Converter={StaticResource BoolToVisibility}}">
                        <controls:NoteCanvas x:Name="RightCanvas" Document="{Binding SecondaryDocument}" Appearance="{Binding SecondaryPageAppearance}" PageTitle="{Binding SecondaryPageTitle}"
                                             SelectedTool="{Binding SelectedTool}" SingleFingerPanEnabled="{Binding SingleFingerPanEnabled}"
                                             PanoramaSensitivity="{Binding PanoramaSensitivity}" InsertSpaceModeEnabled="{Binding InsertSpaceModeEnabled}" PendingTagKind="{Binding PendingTagKind, Mode=TwoWay}" ZoomLocked="{Binding ZoomLocked}" PredictionEnabled="{Binding PredictionEnabled}" />
                    </Border>

                    <StackPanel x:Name="FullPagePaneButtons" Grid.ColumnSpan="3" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Visibility="{Binding IsFullPageMode, Converter={StaticResource BoolToVisibility}}">
                        <ToggleButton Style="{StaticResource CanvasActionToggleButtonStyle}" Margin="0,0,0,4" ToolTip="折叠或展开分区栏" AutomationProperties.AutomationId="FullPageSectionPaneButton" IsChecked="{Binding IsSectionPaneOpen}"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="{StaticResource Fluent_navigation}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></Canvas></Viewbox></ToggleButton>
                        <ToggleButton Style="{StaticResource CanvasActionToggleButtonStyle}" ToolTip="折叠或展开页面栏" AutomationProperties.AutomationId="FullPagePagePaneButton" IsChecked="{Binding IsPagePaneOpen}"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="{StaticResource Fluent_panel_left}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></Canvas></Viewbox></ToggleButton>
                    </StackPanel>

                    <Border Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" Padding="4,2" CornerRadius="3" Background="#232323" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsFullPageMode}" Value="True" />
                                            <Condition Binding="{Binding IsFloatingToolbarVisible}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ItemsControl ItemsSource="{Binding FullPageToolbarItems}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource AndroidCommandToggleButtonStyle}" ToolTip="{Binding Label}" Tag="{Binding Id}" IsChecked="{Binding IsSelected, Mode=OneWay}" PreviewMouseLeftButtonDown="OnToolPresetPreviewMouseLeftButtonDown" Click="OnFullPageToolClick">
                                        <Grid Width="18" Height="18">
                                            <Path x:Name="singleColorIcon" Data="{Binding IconKey, Converter={StaticResource FluentIcon}}" Fill="{Binding TintHex}" Stretch="Uniform" />
                                            <Image x:Name="multiColorIcon" Source="{Binding IconKey, Converter={StaticResource FluentDrawingIcon}}" Stretch="Uniform" Visibility="Collapsed" />
                                        </Grid>
                                    </ToggleButton>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding PreserveColors}" Value="True">
                                            <Setter TargetName="singleColorIcon" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="multiColorIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel x:Name="CanvasActions" Grid.ColumnSpan="3" Panel.ZIndex="50" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Margin" Value="0,6,7,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFullPageMode}" Value="True"><Setter Property="Margin" Value="0,6,145,0" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ToggleButton Style="{StaticResource RibbonToggleButtonStyle}" ToolTip="显示或隐藏绘图工具栏" IsChecked="{Binding IsFloatingToolbarVisible}"
                                      Visibility="{Binding IsFullPageMode, Converter={StaticResource BoolToVisibility}}"><Path Data="{StaticResource Fluent_pen}" Fill="{StaticResource TextPrimary}" Width="17" Height="17" /></ToggleButton>
                        <Button Style="{StaticResource CanvasActionButtonStyle}" ToolTip="搜索笔记" Click="OnSearchClick"><Path Data="{StaticResource Fluent_search}" Fill="{StaticResource TextPrimary}" Width="20" Height="20" /></Button>
                        <Button x:Name="EnterFullPageButton" Style="{StaticResource CanvasActionButtonStyle}" ToolTip="进入整页视图" AutomationProperties.AutomationId="EnterFullPageButton" Command="{Binding ToggleFullPageCommand}" Visibility="{Binding IsNormalChromeVisible, Converter={StaticResource BoolToVisibility}}"><Grid Width="20" Height="20"><Path Data="{StaticResource Fluent_full_screen_maximize}" Fill="{StaticResource TextPrimary}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Button>
                        <Button x:Name="ExitFullPageButton" Style="{StaticResource CanvasActionButtonStyle}" ToolTip="退出整页视图" AutomationProperties.AutomationId="ExitFullPageButton" Command="{Binding ToggleFullPageCommand}" Visibility="{Binding IsFullPageMode, Converter={StaticResource BoolToVisibility}}"><Grid Width="20" Height="20"><Path Data="{StaticResource Fluent_full_screen_minimize}" Fill="{StaticResource TextPrimary}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Button>
                    </StackPanel>

                    <Border x:Name="SearchPanel" Grid.ColumnSpan="3" Panel.ZIndex="30" Width="360" MaxHeight="380" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,7,0"
                            Background="#232323" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="3" Visibility="Collapsed">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="36" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource Fluent_search}" Fill="{StaticResource TextSecondary}" Width="15" Height="15" Margin="9,0,6,0" />
                                    <Button DockPanel.Dock="Right" Content="×" Width="30" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Click="OnCloseSearchClick" />
                                    <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="2,6" FontSize="12" VerticalContentAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.NavigateSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Click="OnSearchResultClick" Background="Transparent" BorderThickness="0" Padding="10,8" HorizontalContentAlignment="Stretch" Cursor="Hand"><TextBlock Text="{Binding DisplayText}" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" /></Button></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10" Padding="8,4" CornerRadius="3" Background="#EE232323" IsHitTestVisible="False">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSaveError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock Text="{Binding SaveStateText}" Foreground="#FFB4AB" FontSize="11" />
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>

        <Popup x:Name="ToolFlyoutPopup" AllowsTransparency="True" StaysOpen="True" Placement="Bottom"
               HorizontalOffset="-8" VerticalOffset="2" IsOpen="{Binding IsToolFlyoutOpen, Mode=TwoWay}">
        <Border Width="316" MaxHeight="650" Background="#232323" BorderBrush="{StaticResource BorderStrong}"
                BorderThickness="1" CornerRadius="3" Padding="12,10">
            <StackPanel>
                <Grid Height="38">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Fluent_pen}" Fill="{Binding SelectedTool.ColorHex}" Width="22" Height="22" Margin="0,0,9,0" Visibility="{Binding SelectedToolIsPen, Converter={StaticResource BoolToVisibility}}" />
                        <Path Data="{StaticResource Fluent_highlight}" Fill="{Binding SelectedTool.ColorHex}" Width="22" Height="22" Margin="0,0,9,0" Visibility="{Binding SelectedToolIsHighlighter, Converter={StaticResource BoolToVisibility}}" />
                        <Path Data="{StaticResource Fluent_eraser}" Fill="{StaticResource TextPrimary}" Width="22" Height="22" Margin="0,0,9,0" Visibility="{Binding SelectedToolIsEraser, Converter={StaticResource BoolToVisibility}}" />
                        <Path Data="{StaticResource Fluent_lasso}" Fill="{StaticResource TextPrimary}" Width="22" Height="22" Margin="0,0,9,0" Visibility="{Binding SelectedToolIsLasso, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding SelectedTool.DisplayName}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{StaticResource BorderHairline}" Margin="0,0,0,8" />

                <StackPanel Visibility="{Binding SelectedToolIsPen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="颜色" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Style="{StaticResource RibbonIconButtonStyle}" Width="34" Height="30" ToolTip="黑色" Tag="Black" Click="OnSetToolColorClick"><Ellipse Width="18" Height="18" Fill="#1B1B1F" Stroke="White" StrokeThickness="1" /></Button>
                        <Button Style="{StaticResource RibbonIconButtonStyle}" Width="34" Height="30" ToolTip="蓝色" Tag="Blue" Click="OnSetToolColorClick"><Ellipse Width="18" Height="18" Fill="#185ABD" /></Button>
                        <Button Style="{StaticResource RibbonIconButtonStyle}" Width="34" Height="30" ToolTip="红色" Tag="Red" Click="OnSetToolColorClick"><Ellipse Width="18" Height="18" Fill="#C42B1C" /></Button>
                    </StackPanel>
                    <DockPanel><TextBlock Text="笔宽" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=WidthSlider, Path=Value, StringFormat={}{0:F1} mm}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="WidthSlider" Minimum="0.1" Maximum="2" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1" Value="{Binding SelectedTool.WidthMm, Mode=TwoWay}" ValueChanged="OnToolSettingChanged" />
                    <DockPanel Margin="0,8,0,0"><TextBlock Text="压感" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=PressureSlider, Path=Value, StringFormat={}{0:F0}%}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="PressureSlider" Minimum="0" Maximum="400" TickFrequency="10" Value="{Binding SelectedTool.PressurePercent, Mode=TwoWay}" ValueChanged="OnToolSettingChanged" />
                    <DockPanel Margin="0,8,0,0"><TextBlock Text="出墨" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=FlowSlider, Path=Value, StringFormat={}{0:F0}%}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="FlowSlider" Minimum="0" Maximum="200" TickFrequency="10" Value="{Binding SelectedTool.InkFlowPercent, Mode=TwoWay}" ValueChanged="OnToolSettingChanged" />
                </StackPanel>

                <StackPanel Visibility="{Binding SelectedToolIsHighlighter, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="颜色" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Style="{StaticResource RibbonIconButtonStyle}" Width="34" Height="30" ToolTip="黑色" Tag="Black" Click="OnSetToolColorClick"><Ellipse Width="18" Height="18" Fill="#1B1B1F" Stroke="White" StrokeThickness="1" /></Button>
                        <Button Style="{StaticResource RibbonIconButtonStyle}" Width="34" Height="30" ToolTip="蓝色" Tag="Blue" Click="OnSetToolColorClick"><Ellipse Width="18" Height="18" Fill="#185ABD" /></Button>
                        <Button Style="{StaticResource RibbonIconButtonStyle}" Width="34" Height="30" ToolTip="红色" Tag="Red" Click="OnSetToolColorClick"><Ellipse Width="18" Height="18" Fill="#C42B1C" /></Button>
                    </StackPanel>
                    <DockPanel><TextBlock Text="宽度" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=HighlighterWidthSlider, Path=Value, StringFormat={}{0:F1} mm}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="HighlighterWidthSlider" Minimum="2" Maximum="12" TickFrequency="0.5" Value="{Binding SelectedTool.WidthMm, Mode=TwoWay}" ValueChanged="OnToolSettingChanged" />
                    <DockPanel Margin="0,8,0,0"><TextBlock Text="透明度" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:F0}%}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="OpacitySlider" Minimum="10" Maximum="70" TickFrequency="5" Value="{Binding SelectedTool.OpacityPercent, Mode=TwoWay}" ValueChanged="OnToolSettingChanged" />
                </StackPanel>

                <StackPanel Visibility="{Binding SelectedToolIsEraser, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel><TextBlock Text="大小" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=EraserSlider, Path=Value, StringFormat={}{0:F1} mm}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="EraserSlider" Maximum="40" Minimum="0.25"
                            SmallChange="0.25" LargeChange="2" TickFrequency="0.25" Value="{Binding SelectedTool.EraserRadiusMm, Mode=TwoWay}" ValueChanged="OnToolSettingChanged" />
                    <CheckBox Content="书写工具用力按压时临时切换到此橡皮" IsChecked="{Binding SelectedTool.PressureEraseEnabled, Mode=TwoWay}"
                              Foreground="{StaticResource TextPrimary}" Margin="0,10,0,2" Click="OnToolSettingChanged" />
                    <DockPanel Margin="0,8,0,0"><TextBlock Text="按压力度" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=EraserThresholdSlider, Path=Value, StringFormat={}{0:F0}%}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="EraserThresholdSlider" Minimum="40" Maximum="100" TickFrequency="2" Value="{Binding SelectedTool.PressureEraseThresholdPercent, Mode=TwoWay}" ValueChanged="OnToolSettingChanged" />
                    <DockPanel Margin="0,8,0,0"><TextBlock Text="按压时间" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=EraserDwellSlider, Path=Value, StringFormat={}{0:F0} ms}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="EraserDwellSlider" Minimum="50" Maximum="500" TickFrequency="10" Value="{Binding SelectedTool.PressureEraseDwellMilliseconds, Mode=TwoWay}" ValueChanged="OnToolSettingChanged" />
                    <DockPanel LastChildFill="False" Margin="0,8,0,0"><TextBlock Text="触发路程上限" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=EraserTravelLimitSlider, Path=Value, StringFormat={}{0:F1} mm}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="EraserTravelLimitSlider" Minimum="0.1" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding SelectedTool.PressureEraseTravelLimitMm, Mode=TwoWay}" ValueChanged="OnToolSettingChanged" />
                    <TextBlock Text="本次落笔超过上限后不再压感切换" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0" />
                    <TextBlock Text="整笔擦除 · 像素擦除稍后接入" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Visibility="{Binding SelectedToolIsShape, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox x:Name="ShapeKindChooser" Style="{StaticResource ShapeChooserStyle}" ItemsSource="{Binding ShapeKinds}" SelectedItem="{Binding SelectedTool.ShapeKind, Mode=TwoWay}" SelectionChanged="OnToolSettingChanged" Margin="0,6,0,8">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ShapeLabelConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="黑色" Tag="Black" Click="OnSetToolColorClick"><Ellipse Width="18" Height="18" Fill="#1B1B1F" Stroke="White" /></Button>
                        <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="蓝色" Tag="Blue" Click="OnSetToolColorClick"><Ellipse Width="18" Height="18" Fill="#185ABD" /></Button>
                        <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTip="红色" Tag="Red" Click="OnSetToolColorClick"><Ellipse Width="18" Height="18" Fill="#C42B1C" /></Button>
                    </StackPanel>
                    <DockPanel LastChildFill="False"><TextBlock Text="线宽" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=ShapeWidthSlider, Path=Value, StringFormat={}{0:F1} mm}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="ShapeWidthSlider" Minimum="0.1" Maximum="2" TickFrequency="0.1" Value="{Binding SelectedTool.WidthMm, Mode=TwoWay}" ValueChanged="OnToolSettingChanged" />
                    <CheckBox Content="停笔转直线" Foreground="{StaticResource TextPrimary}" IsChecked="{Binding ShapeSettings.HoldToStraightenEnabled, Mode=TwoWay}" Click="OnToolSettingChanged" Margin="0,10,0,6" />
                    <DockPanel LastChildFill="False"><TextBlock Text="等待时间" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=StraightenDelaySlider, Path=Value, StringFormat={}{0:F0} ms}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="StraightenDelaySlider" Minimum="200" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding ShapeSettings.StraightenDelayMillis, Mode=TwoWay}" ValueChanged="OnToolSettingChanged" />
                </StackPanel>

                <StackPanel Visibility="{Binding SelectedToolIsLasso, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="形状" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="自由圈选" Tag="Freeform" IsChecked="{Binding SelectedLassoIsFreeform, Mode=OneWay}"
                                      Style="{StaticResource RibbonToggleButtonStyle}" Height="30" MinWidth="82" Click="OnSetLassoShapeClick" />
                        <ToggleButton Content="矩形" Tag="Rectangle" IsChecked="{Binding SelectedLassoIsRectangle, Mode=OneWay}"
                                      Style="{StaticResource RibbonToggleButtonStyle}" Height="30" MinWidth="64" Click="OnSetLassoShapeClick" />
                    </StackPanel>
                    <TextBlock Text="可同时选择笔迹、标记、文本框和插入对象" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="Backspace / Delete 删除所选；拖动框内移动；八个方形控点缩放" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>

            </StackPanel>
        </Border>
        </Popup>

        <Popup x:Name="PanoramaFlyoutPopup" AllowsTransparency="True" StaysOpen="False" Placement="Bottom"
               HorizontalOffset="-8" VerticalOffset="2">
            <Border Width="300" Background="#232323" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="3" Padding="12,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Height="34">
                        <Path Data="{StaticResource Fluent_hand_left}" Fill="{StaticResource TextPrimary}" Width="22" Height="22" Margin="0,0,9,0" />
                        <TextBlock Text="全景手柄" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource BorderHairline}" Margin="0,0,0,8" />
                    <DockPanel><TextBlock Text="移动灵敏度" Foreground="{StaticResource TextSecondary}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=PanoramaSensitivitySlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource TextPrimary}" /></DockPanel>
                    <Slider x:Name="PanoramaSensitivitySlider" Minimum="{x:Static vm:MainViewModel.MinimumPanoramaSensitivity}" Maximum="{x:Static vm:MainViewModel.MaximumPanoramaSensitivity}"
                            SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" Value="{Binding PanoramaSensitivity, Mode=TwoWay}" />
                    <TextBlock Text="同时作用于全景手柄和中键 / 笔侧键临时平移" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>

        <controls:BackstageView x:Name="Backstage" Visibility="{Binding IsBackstageOpen, Converter={StaticResource BoolToVisibility}}" />

        <!-- Caption buttons float above the top row, full-page canvas and Backstage alike. -->
        <StackPanel x:Name="CaptionButtons" Panel.ZIndex="100" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimizeCaptionButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="最小化"
                    AutomationProperties.AutomationId="MinimizeCaptionButton" Click="OnMinimizeCaptionClick" />
            <Button x:Name="MaximizeCaptionButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" ToolTip="最大化"
                    AutomationProperties.AutomationId="MaximizeCaptionButton" Click="OnMaximizeCaptionClick" />
            <Button x:Name="CloseCaptionButton" Style="{StaticResource CaptionButtonStyle}" Tag="Close" Content="&#xE8BB;" ToolTip="关闭"
                    AutomationProperties.AutomationId="CloseCaptionButton" Click="OnCloseCaptionClick" />
        </StackPanel>
    </Grid>
</Window>
